# Database Configuration
# Local MongoDB: mongodb://127.0.0.1:27017/wholesale_mgmt
# Remote Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/wholesale_mgmt

# Port to run the server on (Railway sets this automatically in production)
PORT=5000

# API key for Google Gemini AI integrations
GEMINI_API_KEY=

# URL of the hosted frontend (for CORS configuration in production)
FRONTEND_URL=https://your-frontend.vercel.app
